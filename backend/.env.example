# TinyFish
TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_BASE_URL=https://api.tinyfish.co/v1

# Gated portal credentials (injected server-side into the web agent)
PORTAL_USER=your_portal_username_here
PORTAL_PASS=your_portal_password_here

# Multimodal Scheme Vision (Gemini 1.5 Flash for scanned image/circular OCR)
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=5000
DEMO_MODE=true
CORS_ORIGIN=http://localhost:5173

# Optional: alert delivery for the diff endpoint (leave blank to simulate)
SLACK_WEBHOOK_URL=

# Cost estimation (USD per 1K tokens, used for the telemetry numbers)
COST_PER_1K_TOKENS_RAW=0.0015
COST_PER_1K_TOKENS_PRUNED=0.002

# Supabase / PostgreSQL Configuration (or MONGODB_URI)
POSTGRES_URI=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# MONGODB_URI=mongodb://localhost:27017/Sarkari%20Sugam-AI

# JWT Authentication
JWT_SECRET=sarkari_sugam_ai_hackiiitd_secret_token_2026
JWT_EXPIRES_IN=24h

# Email Delivery for Password Reset (Gmail / SendGrid / Custom SMTP)
# (Leave empty for automated virtual test inbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sarkari Sugam AI <noreply@sarkarisugam.ai.in>"
